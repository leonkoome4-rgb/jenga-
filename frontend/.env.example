# Leave blank for the included local Vite proxy or Docker/Nginx deployment.
# Set this only when the frontend and API are hosted on different public domains.
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Same value as backend/.env's GOOGLE_CLIENT_ID. The "Sign in with Google"
# button hides itself when this is unset.
VITE_GOOGLE_CLIENT_ID=
