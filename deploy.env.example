# Copy to .env at the repository root before running Docker Compose.
# Generate long random values; never commit the filled-in .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Set this to your public frontend URL after deployment.
FRONTEND_ORIGIN=https://your-domain.example

# Required for the AI Hub. Leave blank only if you intentionally disable it.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1

# Required when using a real Cloudflare Turnstile site key in the frontend.
TURNSTILE_SECRET_KEY=
